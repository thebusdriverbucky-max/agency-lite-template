{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownyourwebsite.app/schemas/agency-lite/work.schema.json",
  "title": "Agency Lite portfolio",
  "type": "array",
  "maxItems": 200,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "category", "description", "image"],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
      },
      "title": { "type": "string", "minLength": 1, "maxLength": 200 },
      "category": { "type": "string", "minLength": 1, "maxLength": 120 },
      "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
      "image": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "^(?:https://|/(?!/))"
      }
    }
  }
}
